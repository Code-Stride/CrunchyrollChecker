# ============ COPY THIS FILE TO `.env` FOR LOCAL RUNS ============
# (On Railway, set the same variables in the Variables tab instead —
#  the dashboard values always win over .env)

# === REQUIRED ===
# Token from @BotFather.
# NOTE: the token that was hardcoded in the old v8 code was committed
# publicly — treat it as leaked and generate a FRESH one in @BotFather.
BOT_TOKEN=

# Your numeric Telegram user id (from @userinfobot)
OWNER_ID=8588291055

# === OPTIONAL (defaults shown) ===
OWNER_USERNAME=@SUNIOxRICH
OWNER_IDS=
ADMIN_USERNAMES=
THREADS=35
DATA_DIR=data
PROXY_REFRESH_MINUTES=15
MAX_PROXIES_TO_KEEP=80
PROXY_TEST_TIMEOUT=8
CHECK_TIMEOUT=12
MAX_FILE_MB=20
PREMIUM_ONLY=true

# Mini App (Railway same-service — Flask on $PORT)
MINI_APP_URL=https://crunchyrollchecker-production-105c.up.railway.app
# RAILWAY_PUBLIC_DOMAIN is auto-set by Railway if you generate a domain
